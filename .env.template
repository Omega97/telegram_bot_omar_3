# .env file with secrets (Telegram token, Admin user IDs, etc.)

# 🔑 Telegram Bot Token (from @BotFather)
BOT_TOKEN=todo_set_your_secret_telegram_token

# 🧂 Random salt
RANDOM_SALT=todo_set_random_salt

# 👮 Admin user IDs (comma-separated, without spaces)
ADMIN_IDS=

# ⏱️ Cooldown for /place command (in minutes)
PLACE_COOLDOWN_MINUTES=3

# 🛠️ Debug mode (set to True during development)
DEBUG=True
